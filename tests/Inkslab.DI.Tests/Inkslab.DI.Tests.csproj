<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- This example retains net6.0 to verify compatibility; it is not a deployment target. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inkslab.Config\Inkslab.Config.csproj" />
    <ProjectReference Include="..\..\src\Inkslab.DI\Inkslab.DI.csproj" />
  </ItemGroup>

</Project>
